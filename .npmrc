# Only resolve versions published at least 14 days ago, matching Renovate's
# minimumReleaseAge; this also covers the transitive versions Renovate never sees.
# To take a fix younger than that, add the package to min-release-age-exclude.
min-release-age=14

# Fail the install when a dependency has install scripts that allowScripts in
# package.json doesn't cover; without this, npm 11 runs them and npm 12 skips
# them. Review a new one with `npm install-scripts ls`, then approve or deny it.
strict-allow-scripts=true
